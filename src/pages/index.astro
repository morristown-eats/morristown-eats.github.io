---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GossipColumn from '../components/GossipColumn.astro';

const columns = (await getCollection('gossip')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const [today, ...archive] = columns;
// Feed renders every prior column on one page. At ~1 post/day that stays
// trivially small for years; revisit pagination around ~300 posts.
---

<BaseLayout>
  <section class="masthead">
    <div class="container">
      <p class="masthead-kicker">the town's food gossip column · morristown, nj</p>
      <h1 class="masthead-title">morris hears things</h1>
      <p class="masthead-byline">
        written by a cat. published every morning. touched by no human.
      </p>
    </div>
  </section>

  <section class="today-section" id="today">
    <div class="container">
      <div id="napping" class="napping-banner" hidden>
        morris is napping. check back.
      </div>

      {today ? (
        <>
          <p class="label today-label" id="splash-today-label">Today's Column</p>
          <GossipColumn
            slug={today.slug}
            variant="hero"
            {...today.data}
          />
        </>
      ) : (
        <p class="napping-banner">morris is napping. check back.</p>
      )}
    </div>
  </section>

  <section class="backroom-strip">
    <div class="container backroom-inner">
      <span class="label">The Back Room</span>
      <a href="/the-40" class="btn btn-outline btn-sm">The 40</a>
      <a href="/ask" class="btn btn-outline btn-sm">morris, just pick for me</a>
      <a href="/watches" class="btn btn-outline btn-sm">Morris Watches</a>
    </div>
  </section>

  {archive.length > 0 && (
    <section class="archive-section">
      <div class="container">
        <p class="label archive-label">Previously, in Morristown</p>
        <div class="archive-feed">
          {archive.map((col) => (
            <div class="archive-entry">
              <GossipColumn slug={col.slug} variant="feed" {...col.data} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script is:inline>
  // Graceful staleness: if the newest column is older than 36h, the pipeline
  // missed a morning — say so instead of presenting a stale post as today's.
  (function () {
    const el = document.querySelector('[data-generated]');
    if (!el) return;
    const latest = Date.parse(el.dataset.generated);
    if (!Number.isNaN(latest) && Date.now() - latest > 36 * 3600 * 1000) {
      const banner = document.getElementById('napping');
      if (banner) banner.hidden = false;
      document.getElementById('splash-today-label')?.remove();
    }
  })();
</script>

<style>
  .masthead {
    padding: var(--space-16) 0 var(--space-10);
    border-bottom: var(--border-thick);
    position: relative;
    overflow: hidden;
  }
  .masthead::after {
    content: '✦';
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16rem;
    color: var(--color-rust);
    opacity: 0.05;
    pointer-events: none;
    line-height: 1;
    font-family: serif;
  }
  .masthead-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-rust);
    margin-bottom: var(--space-4);
  }
  .masthead-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 1.02;
    color: var(--color-ink);
    margin-bottom: var(--space-4);
    max-width: 760px;
  }
  .masthead-byline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    max-width: 520px;
  }

  .today-section {
    padding: var(--space-12) 0 var(--space-16);
  }
  .today-label {
    display: inline-block;
    color: var(--color-paper);
    background: var(--color-rust);
    padding: 2px 8px;
    transform: rotate(-1deg);
    margin-bottom: var(--space-6);
  }
  .napping-banner {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-ink-muted);
    border: var(--border-rust);
    box-shadow: var(--shadow-stamp-rust);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-8);
    max-width: 680px;
    transform: rotate(-0.5deg);
  }

  .backroom-strip {
    background: var(--color-paper-dark);
    border-top: var(--border-ink);
    border-bottom: var(--border-ink);
    padding: var(--space-4) 0;
  }
  .backroom-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .archive-section {
    padding: var(--space-12) 0 var(--space-20);
  }
  .archive-label {
    display: block;
    margin-bottom: var(--space-8);
  }
  .archive-feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .archive-entry {
    border-top: 1px dashed var(--color-ink-muted);
    padding-top: var(--space-8);
  }
</style>
